# Copy to .env for local runs. In GitHub Actions, set these as repo Secrets instead
# (Settings > Secrets and variables > Actions) - never commit real values.

# --- Dhan API: Option B (static token, chosen setup) ---
# Generate from web.dhan.co -> My Profile -> Access DhanHQ APIs -> Generate Access Token
# Expires every 24h - you must refresh this + update the secret yourself daily.
# The "Check Dhan token" GitHub Action will Telegram-alert you if it's stale.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# --- Dhan API: Option A (TOTP auto-refresh) - only if you switch later ---
# Setting DHAN_PIN + DHAN_TOTP_SECRET switches the scanner into this mode
# automatically (checked before DHAN_ACCESS_TOKEN) - never needs manual refresh.
# DHAN_PIN=
# DHAN_TOTP_SECRET=

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Scanner tuning (optional, defaults live in config.py) ---
SCANNER_DATA_SOURCE=dhan
SCANNER_MODE=eod
MIN_MARKET_CAP_CR=1000
MIN_PRICE=20
RECENCY_BARS=5
MIN_REACCUM_BARS=5
PRE_BOS2_PROXIMITY_PCT=0.03
SCANNER_DEBUG=false

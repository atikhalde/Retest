# Copy to .env for local runs. In GitHub Actions, set these as repo Secrets instead
# (Settings > Secrets and variables > Actions) - never commit real values.

# --- Dhan API: choose ONE auth mode ---
# Mode A (recommended for unattended cron - survives weekends without manual refresh)
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=

# Mode B (simplest, but this token expires every 24h and must be refreshed manually)
# DHAN_ACCESS_TOKEN=

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Scanner tuning (optional, defaults live in config.py) ---
SCANNER_DATA_SOURCE=dhan
SCANNER_MODE=eod
MIN_MARKET_CAP_CR=1000
MIN_PRICE=20
RECENCY_BARS=5
MIN_REACCUM_BARS=5
PRE_BOS2_PROXIMITY_PCT=0.03
SCANNER_DEBUG=false
